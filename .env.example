# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# JANGAN commit .env ke git.

# ---- Database (dipakai aplikasi DAN container PostgreSQL) ----
DB_NAME=okariru
DB_USERNAME=okariru
DB_PASSWORD=ganti-dengan-password-kuat
DB_SCHEMA=core
# DB_URL dirakit otomatis oleh docker-compose (host = service "postgres").
# Isi ini hanya kalau menjalankan aplikasi langsung dari IDE, bukan Docker:
# DB_URL=jdbc:postgresql://localhost:5432/okariru?currentSchema=core

# ---- Redis ----
REDIS_PORT=6379
# REDIS_HOST diatur otomatis oleh docker-compose (service "redis")
# REDIS_USERNAME=
# REDIS_PASSWORD=

# ---- Security ----
# Minimal 32 karakter. Buat dengan:  openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_TTL_MINUTES=60
# Asal frontend yang diizinkan CORS (menimpa nilai di application.properties)
APP_SECURITY_CORS_ALLOWED_ORIGIN=http://okariru-fe.vercel.app

# ---- Email (SMTP Gmail, pakai App Password) ----
SPRING_MAIL_USERNAME=email-anda@gmail.com
SPRING_MAIL_PASSWORD=app-password-gmail

# ---- Aplikasi / Docker ----
APP_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75
# Jalankan container sebagai user host ini supaya bisa menulis ke folder uploads (cek dengan: id -u ; id -g)
APP_UID=1000
APP_GID=1000

# ---- Lokasi data di mesin host (bind mount) ----
POSTGRES_DATA_DIR=./data/postgres
UPLOADS_DIR=./data/uploads
REDIS_DATA_DIR=./data/redis
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
