# Template konfigurasi CI/CD -> dikirim ke GitHub (repository-level) oleh scripts/gh/setup-github.sh
#
#   cp .env.github.example .env.github        # lalu isi semua nilai (ganti CHANGE_ME)
#   bash scripts/gh/setup-github.sh --dry-run # cek dulu tanpa mengirim
#   bash scripts/gh/setup-github.sh           # kirim ke GitHub via gh CLI
#
# .env.github berisi rahasia -> sudah di-gitignore, JANGAN di-commit.
# Nama section di bawah ([...]) dibaca oleh script, jangan diubah/dihapus.
# Nilai kosong pada variable opsional akan dilewati (compose memakai default-nya).

# ===================== [variables] =====================
# Bukan rahasia -> disimpan sebagai GitHub Actions *variables*
[variables]
# -- Server target --
SERVER_HOST=35.184.39.133
SERVER_USER=jasonoke03
SERVER_PORT=22
# Path ABSOLUT di server. Pakai home user supaya tidak butuh sudo.
DEPLOY_PATH=/home/jasonoke03/okariru

# -- Database (dipakai aplikasi DAN container PostgreSQL) --
DB_NAME=okariru
DB_USERNAME=okariru
DB_SCHEMA=core

# -- Aplikasi --
# Asal frontend yang diizinkan CORS
APP_SECURITY_CORS_ALLOWED_ORIGIN=https://okariru-fe.vercel.app
SPRING_MAIL_USERNAME=CHANGE_ME@gmail.com
JWT_TTL_MINUTES=60
APP_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75
REDIS_PORT=6379

# -- Opsional (kosongkan untuk pakai default compose) --
# UID/GID user di server (cek: id -u ; id -g). Harus sama dengan pemilik folder uploads.
APP_UID=1000
APP_GID=1000
# Lokasi data di server, relatif terhadap DEPLOY_PATH (atau path absolut)
POSTGRES_DATA_DIR=./data/postgres
UPLOADS_DIR=./uploads
REDIS_DATA_DIR=./data/redis

# ===================== [secrets] =====================
# Rahasia bernilai satu baris -> disimpan sebagai GitHub Actions *secrets*
[secrets]
# Buat dengan: openssl rand -hex 16
DB_PASSWORD=CHANGE_ME
# Minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
# App Password Gmail (BUKAN password login). https://myaccount.google.com/apppasswords
SPRING_MAIL_PASSWORD=CHANGE_ME

# ===================== [secret-files] =====================
# Nilainya PATH ke file lokal; isi file dikirim apa adanya sebagai secret
[secret-files]
# Private key SSH khusus CI (public key-nya sudah terdaftar di server)
SSH_PRIVATE_KEY=~/.ssh/ci_deploy_key

# ===================== [secret-files-b64] =====================
# Sama seperti di atas, tapi isi file di-encode base64 dulu (untuk file JSON/multi-baris)
[secret-files-b64]
FIREBASE_CREDENTIALS_B64=./firebase-service-account.json
